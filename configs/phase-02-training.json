  },
  "model_version": "1.0.0",
  "preprocessing": {
    "categorical_imputer": {
      "add_indicator": false,
      "copy": true,
      "fill_value": "__MISSING__",
      "keep_empty_features": false,
      "missing_values": "nan",
      "strategy": "constant"
    },
    "column_transformer": {
      "n_jobs": null,
      "remainder": "drop",
      "sparse_threshold": 0.3,
      "transformer_weights": null,
      "verbose": false,
      "verbose_feature_names_out": true
    },
    "numeric_imputer": {
      "add_indicator": false,
      "copy": true,
      "fill_value": null,
