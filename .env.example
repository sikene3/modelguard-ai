# Safe, non-secret local defaults. Copy to .env only for local overrides.
# Never add AWS credentials, API tokens, passwords, or private keys here.
APP_ENV=local
LOG_LEVEL=INFO
MODEL_BUNDLE_PATH=artifacts/model-bundles/1.0.0
ACTIVE_MODEL_VERSION=1.0.0
MODEL_BUNDLE_TRUSTED_ORIGIN=true
API_ACCESS_MODE=local_open
ALB_ALLOWED_CIDR=
PREDICTION_TOKEN_SSM_ARN=
# In https_token mode ECS injects this value from the ARN above; never commit a value here.
PREDICTION_BEARER_TOKEN=
API_MAX_REQUEST_BODY_BYTES=16384
API_MAX_CONCURRENCY=64
API_INFERENCE_WORKERS=1
API_CONCURRENCY_WAIT_TIMEOUT_SECONDS=1.0
EVENT_SINK_TIMEOUT_SECONDS=0.75
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=10.0
# local | aws | disabled; APP_ENV=aws permits only aws or disabled.
EVENT_SINK=local
LOCAL_EVENT_DIR=artifacts/predictions
FIREHOSE_CONNECT_TIMEOUT_SECONDS=0.1
FIREHOSE_READ_TIMEOUT_SECONDS=0.2
FIREHOSE_MAX_ATTEMPTS=2
FIREHOSE_RETRY_BASE_DELAY_SECONDS=0.025
LOCAL_REPORT_DIR=artifacts/reports
MIN_MONITORING_SAMPLES=500
# Dashboard is read-only. Local mode reads the paths above; s3 mode requires both buckets below.
DASHBOARD_REPOSITORY=local
MONITORING_CONFIG_PATH=configs/phase-05-monitoring.json
DASHBOARD_HISTORY_LIMIT=24
DASHBOARD_MAX_JSON_BYTES=8388608
DASHBOARD_MAX_HTML_BYTES=16777216
DASHBOARD_REPORT_PREFIX=monitoring/
DASHBOARD_MODEL_PREFIX=model-bundles/
DASHBOARD_PRESIGNED_URL_TTL_SECONDS=300
DASHBOARD_AWS_CONNECT_TIMEOUT_SECONDS=0.5
DASHBOARD_AWS_READ_TIMEOUT_SECONDS=2.0
AWS_REGION=us-east-1
MODEL_BUCKET=
PREDICTION_BUCKET=
REPORT_BUCKET=
FIREHOSE_STREAM_NAME=
ACTIVE_MODEL_SSM_PARAMETER=
SNS_TOPIC_ARN=
# Docker Compose local-only ports and evidence namespaces. The scripts set unique run/event names.
MODELGUARD_API_PORT=8000
MODELGUARD_DASHBOARD_PORT=8501
DEMO_RUN_ID=default
DEMO_EVENT_SET=active
