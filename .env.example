# Safe, non-secret local defaults. Copy to .env only for local overrides.
# Never add AWS credentials, API tokens, passwords, or private keys here.
APP_ENV=local
LOG_LEVEL=INFO
MODEL_BUNDLE_PATH=artifacts/model-bundles/1.0.0
ACTIVE_MODEL_VERSION=1.0.0
MODEL_BUNDLE_TRUSTED_ORIGIN=true
API_ACCESS_MODE=local_open
ALB_ALLOWED_CIDR=
PREDICTION_TOKEN_SSM_ARN=
# In https_token mode ECS injects this value from the ARN above; never commit a value here.
PREDICTION_BEARER_TOKEN=
API_MAX_REQUEST_BODY_BYTES=16384
API_MAX_CONCURRENCY=64
API_INFERENCE_WORKERS=1
API_CONCURRENCY_WAIT_TIMEOUT_SECONDS=1.0
EVENT_SINK_TIMEOUT_SECONDS=0.1
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=10.0
EVENT_SINK=local
LOCAL_EVENT_DIR=artifacts/predictions
LOCAL_REPORT_DIR=artifacts/reports
MIN_MONITORING_SAMPLES=500
AWS_REGION=us-east-1
MODEL_BUCKET=
PREDICTION_BUCKET=
REPORT_BUCKET=
FIREHOSE_STREAM_NAME=
ACTIVE_MODEL_SSM_PARAMETER=
SNS_TOPIC_ARN=
