aws_account_id        = "123456789012"
aws_region            = "us-east-1"
owner_tag             = "portfolio-owner"
deployment_governance_mode = "team_protected"
auto_destroy_date     = "2026-08-09"
backend_bucket_name   = "modelguard-ai-terraform-state-123456789012-us-east-1"
permission_boundary_arn = "arn:aws:iam::123456789012:policy/modelguard-ai/bootstrap/modelguard-ai-workload-boundary"
alert_kms_key_arn        = "arn:aws:kms:us-east-1:123456789012:key/00000000-0000-0000-0000-000000000000"

alb_allowed_cidr = "203.0.113.10/32"

# Preferred mode. These are references only; token bytes never enter Terraform. The pre-created
# SecureString must use alias/aws/ssm for the Phase 08 boundary.
api_access_mode         = "https_token"
acm_certificate_arn     = "arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"
prediction_token_ssm_arn = "arn:aws:ssm:us-east-1:123456789012:parameter/modelguard-ai/demo/secrets/prediction-token"

# Prerequisite saved plan: leave these exact defaults and omit image references.
deployment_stage = "prerequisites"
activate_services = false
runtime_contract_verified = false
budget_prerequisite_verified = false

# Activation saved plan only: set deployment_stage=activation, activate_services=true, and resolve
# all three values from ECR DescribeImages. Never use mutable tags.
# Set runtime_contract_verified=true only after the digest-pinned image contract tests pass.
# Set budget_prerequisite_verified=true only after the value-free read-only USD 10 budget preflight.
# Bind these values to the same verified active pointer; include all seven exact S3 VersionIds.
# expected_model_version         = "1.0.0"
# expected_model_manifest_sha256 = "<64-hex>"
# expected_model_object_version_ids = {
#   "baseline_profile.json" = "<S3-VersionId>"
#   "checksums.sha256"      = "<S3-VersionId>"
#   "input_schema.json"     = "<S3-VersionId>"
#   "manifest.json"         = "<S3-VersionId>"
#   "metrics.json"          = "<S3-VersionId>"
#   "model.joblib"          = "<S3-VersionId>"
#   "threshold.json"        = "<S3-VersionId>"
# }
# api_image_ref       = "123456789012.dkr.ecr.us-east-1.amazonaws.com/modelguard-ai/demo/api@sha256:<64-hex>"
# dashboard_image_ref = "123456789012.dkr.ecr.us-east-1.amazonaws.com/modelguard-ai/demo/dashboard@sha256:<64-hex>"
# monitor_image_ref   = "123456789012.dkr.ecr.us-east-1.amazonaws.com/modelguard-ai/demo/monitor@sha256:<64-hex>"

# The retained USD 10 budget is created manually in the AWS Console with 50/80/100 percent actual
# and 100 percent forecast alerts. Enter its endpoint only in the Console; it is never Terraform
# input or state. Budget alerts are warnings and are not a hard spending cap.
